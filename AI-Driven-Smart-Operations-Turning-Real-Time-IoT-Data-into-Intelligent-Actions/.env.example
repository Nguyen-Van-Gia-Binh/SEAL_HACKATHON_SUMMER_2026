# Kafka / Redpanda Cluster
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TOPIC_RAW=weather-raw
TOPIC_AGGREGATED=weather-aggregated
TOPIC_ALERTS=weather-alerts
TOPIC_FORECASTS=weather-forecasts

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_WEATHER=iot/weather/#

# CoAP Gateway
COAP_HOST=0.0.0.0
COAP_PORT=5683

# Stream Processing Engine Configuration
WATERMARK_DELAY_SECONDS=5.0
TUMBLING_WINDOW_SIZE_SEC=60
SLIDING_WINDOW_SIZE_SEC=300
SLIDING_WINDOW_SLIDE_SEC=60

# AI Provider Configuration (Optional: system runs with built-in heuristic AI if keys are not provided)
AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-1.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# Web Dashboard Backend
API_PORT=8000
API_HOST=0.0.0.0
